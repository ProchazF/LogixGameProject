  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "LOGIX \u2013 RULES\n\nThe board is a 7\xD77 grid. At the start, one black
    marble is placed in the center.\n\nPlayers take turns. On your turn, you may:\n\n-
    Place a marble from your inventory next to an existing marble (orthogonally).\n\n-
    Move a marble on the board to an empty adjacent valid spot (unless blocked).\n\n-
    Replace an opponent\u2019s marble with one from your inventory.\n\nYou cannot
    use the same color (or colors) your opponent used in their last move.\n\nGrey
    marbles are jokers and count as any color.\n\nBlack marble must always be part
    of a winning shape.\n\nA winning shape is five connected marbles that match one
    of your two shape cards.\n\nShapes may be rotated but not mirrored.\n\nThe shape
    must be built from one consistent color (except black/grey).\n\nThe card\u2019s
    blocked color may not be used.\n\nThe first player to complete one of their shapes
    wins."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
