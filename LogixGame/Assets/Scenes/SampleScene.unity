  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "ABOUT LOGIX\n\nLogix is a strategic board game created as part of a programming
    project in Unity.\nThe goal of the game is to build special 5-marble shapes,
    called winning cards, on a 7\xD77 board.\n\nFeatures:\n\nPlay against a friend
    (PvP)\n\nPlay against an AI bot with different difficulty levels (PvE)\n\nWatch
    two AI bots play against each other (EvE)\n\nVisual inventory and interactive
    board\n\nAI powered by a Monte Carlo Tree Search (MCTS) algorithm\n\nCredits:\n\nDevelopment
    & Design: Franti\u0161ek Proch\xE1zka\n\nEngine: Unity with C#\n\nAssets: TextMeshPro
    & Unity UI\n\nThis project was built for learning and experimentation with game
    design, artificial intelligence, and user interface development."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
